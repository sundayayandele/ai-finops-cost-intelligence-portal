# ── Azure ─────────────────────────────────────────────────────────────────────
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=your-client-secret-here
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_AI_FOUNDRY_ENDPOINT=https://your-foundry.api.azureml.ms
AZURE_PROMETHEUS_URL=http://prometheus-azure:9090

# ── OpenStack ─────────────────────────────────────────────────────────────────
OS_AUTH_URL=http://keystone.your-openstack.cloud:5000/v3
OS_USERNAME=finops-service-account
OS_PASSWORD=your-openstack-password
OS_PROJECT_NAME=ai-finops
OS_PROJECT_ID=00000000-0000-0000-0000-000000000000
OS_REGION_NAME=RegionOne
OS_USER_DOMAIN_ID=default
GNOCCHI_URL=http://gnocchi.your-openstack.cloud:8041
VLLM_METRICS_URLS=http://vllm-llama:8000/metrics,http://vllm-mistral:8000/metrics
VLLM_BASE_URL=http://vllm-service:8000
OS_PROMETHEUS_URL=http://prometheus-openstack:9090

# ── OpenStack Internal GPU Billing Rates (USD/hr, CapEx amortised) ────────────
OS_RATE_A100_80GB=1.85
OS_RATE_A100_40GB=1.20
OS_RATE_V100=0.45
OS_RATE_H100=3.20
OS_RATE_T4=0.18

# ── Infrastructure ─────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP=kafka:9092
TIMESCALE_DSN=postgresql://finops:finops@timescaledb:5432/ai_costs
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
REDIS_URL=redis://redis:6379
